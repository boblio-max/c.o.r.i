<?xml version="1.0"?>
<!--
  Robot Arm URDF
  All dimensions in meters (URDF standard).
  Link spacing: 2.5 inches = 63.5mm = 0.0635m (servo horn to servo horn)
  Servo body approx: 40mm x 20mm x 38mm (standard MG996R-class servo)
-->
<robot name="servo_arm">

  <!-- ===================== MATERIALS ===================== -->
  <material name="dark_grey">
    <color rgba="0.2 0.2 0.2 1.0"/>
  </material>
  <material name="red">
    <color rgba="0.8 0.1 0.1 1.0"/>
  </material>
  <material name="light_grey">
    <color rgba="0.6 0.6 0.6 1.0"/>
  </material>

  <!-- ===================== BASE FOOTPRINT ===================== -->
  <link name="base_footprint"/>

  <!-- ===================== BASE PLATFORM ===================== -->
  <!-- Circular base: ~120mm diameter, ~30mm tall -->
  <link name="base_link">
    <visual>
      <geometry>
        <cylinder radius="0.060" length="0.030"/>
      </geometry>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.060" length="0.030"/>
      </geometry>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <origin xyz="0 0 0.015"/>
      <inertia ixx="0.0003" ixy="0" ixz="0"
               iyy="0.0003" iyz="0"
               izz="0.0005"/>
    </inertial>
  </link>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ===================== TURNTABLE (gear-driven yaw) ===================== -->
  <link name="turntable_link">
    <visual>
      <geometry>
        <cylinder radius="0.050" length="0.015"/>
      </geometry>
      <origin xyz="0 0 0.0075" rpy="0 0 0"/>
      <material name="light_grey"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.050" length="0.015"/>
      </geometry>
      <origin xyz="0 0 0.0075" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 0.0075"/>
      <inertia ixx="0.00005" ixy="0" ixz="0"
               iyy="0.00005" iyz="0"
               izz="0.00008"/>
    </inertial>
  </link>

  <!-- Base yaw: 0-180 deg -->
  <joint name="joint_base_yaw" type="revolute">
    <parent link="base_link"/>
    <child link="turntable_link"/>
    <origin xyz="0 0 0.030" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="0.0" upper="3.14159" effort="10.0" velocity="1.0"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>

  <!-- ===================== SHOULDER BRACKET ===================== -->
  <!-- Height = 63.5mm (one link spacing) -->
  <link name="shoulder_bracket_link">
    <visual>
      <geometry>
        <box size="0.040 0.030 0.0635"/>
      </geometry>
      <origin xyz="0 0 0.03175" rpy="0 0 0"/>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.040 0.030 0.0635"/>
      </geometry>
      <origin xyz="0 0 0.03175" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 0.03175"/>
      <inertia ixx="0.00003" ixy="0" ixz="0"
               iyy="0.00003" iyz="0"
               izz="0.00001"/>
    </inertial>
  </link>

  <joint name="joint_shoulder_bracket" type="fixed">
    <parent link="turntable_link"/>
    <child link="shoulder_bracket_link"/>
    <origin xyz="0 0 0.015" rpy="0 0 0"/>
  </joint>

  <!-- ===================== SHOULDER SERVO ===================== -->
  <link name="shoulder_link">
    <visual>
      <geometry>
        <box size="0.040 0.020 0.038"/>
      </geometry>
      <origin xyz="0 0 0.019" rpy="0 0 0"/>
      <material name="red"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.040 0.020 0.038"/>
      </geometry>
      <origin xyz="0 0 0.019" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.065"/>
      <origin xyz="0 0 0.019"/>
      <inertia ixx="0.00004" ixy="0" ixz="0"
               iyy="0.00004" iyz="0"
               izz="0.00002"/>
    </inertial>
  </link>

  <!-- Shoulder pitch: joint exactly 63.5mm above bracket base -->
  <joint name="joint_shoulder_pitch" type="revolute">
    <parent link="shoulder_bracket_link"/>
    <child link="shoulder_link"/>
    <origin xyz="0 0 0.0635" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="3.14159" effort="10.0" velocity="1.0"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  <!-- ===================== UPPER ARM ===================== -->
  <!-- Shoulder horn to elbow horn: 63.5mm -->
  <link name="upper_arm_link">
    <visual>
      <geometry>
        <box size="0.025 0.020 0.0635"/>
      </geometry>
      <origin xyz="0 0 0.03175" rpy="0 0 0"/>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.025 0.020 0.0635"/>
      </geometry>
      <origin xyz="0 0 0.03175" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.04"/>
      <origin xyz="0 0 0.03175"/>
      <inertia ixx="0.00003" ixy="0" ixz="0"
               iyy="0.00003" iyz="0"
               izz="0.000005"/>
    </inertial>
  </link>

  <joint name="joint_upper_arm" type="fixed">
    <parent link="shoulder_link"/>
    <child link="upper_arm_link"/>
    <origin xyz="0 0 0.038" rpy="0 0 0"/>
  </joint>

  <!-- ===================== ELBOW SERVO ===================== -->
  <link name="elbow_link">
    <visual>
      <geometry>
        <box size="0.040 0.020 0.038"/>
      </geometry>
      <origin xyz="0 0 0.019" rpy="0 0 0"/>
      <material name="red"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.040 0.020 0.038"/>
      </geometry>
      <origin xyz="0 0 0.019" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.065"/>
      <origin xyz="0 0 0.019"/>
      <inertia ixx="0.00004" ixy="0" ixz="0"
               iyy="0.00004" iyz="0"
               izz="0.00002"/>
    </inertial>
  </link>

  <!-- Elbow pitch: 63.5mm from shoulder horn -->
  <joint name="joint_elbow_pitch" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="elbow_link"/>
    <origin xyz="0 0 0.0635" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="3.14159" effort="10.0" velocity="1.0"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  <!-- ===================== FOREARM ===================== -->
  <!-- Elbow horn to wrist horn: 63.5mm -->
  <link name="forearm_link">
    <visual>
      <geometry>
        <box size="0.025 0.020 0.0635"/>
      </geometry>
      <origin xyz="0 0 0.03175" rpy="0 0 0"/>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.025 0.020 0.0635"/>
      </geometry>
      <origin xyz="0 0 0.03175" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.035"/>
      <origin xyz="0 0 0.03175"/>
      <inertia ixx="0.00002" ixy="0" ixz="0"
               iyy="0.00002" iyz="0"
               izz="0.000004"/>
    </inertial>
  </link>

  <joint name="joint_forearm" type="fixed">
    <parent link="elbow_link"/>
    <child link="forearm_link"/>
    <origin xyz="0 0 0.038" rpy="0 0 0"/>
  </joint>

  <!-- ===================== WRIST SERVO ===================== -->
  <link name="wrist_link">
    <visual>
      <geometry>
        <box size="0.040 0.020 0.038"/>
      </geometry>
      <origin xyz="0 0 0.019" rpy="0 0 0"/>
      <material name="red"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.040 0.020 0.038"/>
      </geometry>
      <origin xyz="0 0 0.019" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.065"/>
      <origin xyz="0 0 0.019"/>
      <inertia ixx="0.00004" ixy="0" ixz="0"
               iyy="0.00004" iyz="0"
               izz="0.00002"/>
    </inertial>
  </link>

  <!-- Wrist pitch: 63.5mm from elbow horn -->
  <joint name="joint_wrist_pitch" type="revolute">
    <parent link="forearm_link"/>
    <child link="wrist_link"/>
    <origin xyz="0 0 0.0635" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="3.14159" effort="5.0" velocity="1.0"/>
    <dynamics damping="0.05" friction="0.05"/>
  </joint>

  <!-- ===================== END EFFECTOR MOUNT ===================== -->
  <link name="end_effector_mount_link">
    <visual>
      <geometry>
        <box size="0.025 0.025 0.025"/>
      </geometry>
      <origin xyz="0 0 0.0125" rpy="0 0 0"/>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.025 0.025 0.025"/>
      </geometry>
      <origin xyz="0 0 0.0125" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.02"/>
      <origin xyz="0 0 0.0125"/>
      <inertia ixx="0.000005" ixy="0" ixz="0"
               iyy="0.000005" iyz="0"
               izz="0.000005"/>
    </inertial>
  </link>

  <joint name="joint_end_effector_mount" type="fixed">
    <parent link="wrist_link"/>
    <child link="end_effector_mount_link"/>
    <origin xyz="0 0 0.038" rpy="0 0 0"/>
  </joint>

  <!-- ===================== GRIPPER ===================== -->
  <link name="gripper_link">
    <visual>
      <geometry>
        <box size="0.030 0.010 0.020"/>
      </geometry>
      <origin xyz="0 0 0.010" rpy="0 0 0"/>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.030 0.010 0.020"/>
      </geometry>
      <origin xyz="0 0 0.010" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.015"/>
      <origin xyz="0 0 0.010"/>
      <inertia ixx="0.000003" ixy="0" ixz="0"
               iyy="0.000003" iyz="0"
               izz="0.000002"/>
    </inertial>
  </link>

  <!-- Gripper: 0-180 deg -->
  <joint name="joint_gripper" type="revolute">
    <parent link="end_effector_mount_link"/>
    <child link="gripper_link"/>
    <origin xyz="0 0 0.025" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0.0" upper="3.14159" effort="3.0" velocity="1.0"/>
    <dynamics damping="0.02" friction="0.02"/>
  </joint>

</robot>
